{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": false, "skipLibCheck": true, "isolatedModules": true, "noEmit": true,
    "types": ["vite/client"], "resolveJsonModule": true, "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "tools"]
}
