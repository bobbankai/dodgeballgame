{
  "name": "overthrow-dodgeball",
  "private": true,
  "version": "1.0.0",
  "description": "OVERTHROW \u2014 a progression-based 3D dodgeball game built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "blender:install": "bash tools/blender/install.sh",
    "assets:details": "blender -b -P tools/blender/bake_details.py",
    "assets:ball": "blender -b -P tools/blender/bake_ball.py"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.1"
  }
}
