{
  "name": "inkbound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/build-assets.mjs",
    "emberfall": "vite --config emberfall/vite.config.ts",
    "emberfall:build": "tsc -p emberfall --noEmit && vite build --config emberfall/vite.config.ts",
    "emberfall:typecheck": "tsc -p emberfall --noEmit"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/patrick-hand": "^5.2.8",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.6",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "gltfpack": "^0.25.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
